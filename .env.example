# Luxury Watch Tokenization - CRE Workflow
# Environment Configuration

# =============================================================================
# Getting Started:
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. For dry run: Keep dummy private key (no gas cost, no funds needed)
# 3. For live test: Replace dummy key with YOUR private key + deploy contracts
# =============================================================================

# Private Key (with 0x prefix, 64 hex characters)
# DUMMY KEY BELOW - For dry run only (Hardhat test account #0)
# For live testing: Replace with YOUR private key that has Sepolia ETH
CRE_ETH_PRIVATE_KEY=ur_private_key

# RPC Endpoints
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Contracts (update after deployment)
LUXURY_WATCH_SEPOLIA=0xEF2Fa135ec51a32c79f85E02fB6Ea5E51E0336aa
WATCH_CONSUMER_SEPOLIA=0x27a7AAbCD0154d929f64F326FE81411A49597DeD

# Etherscan (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key

# Pinata IPFS (for automated metadata uploads)
# Get your JWT from https://app.pinata.cloud/developers/api-keys
PINATA_JWT=your_pinata_jwt_here
